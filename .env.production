# Build-only non-production Firebase web configuration. These are public Firebase
# identifiers, not credentials. Deployment environments supply their own
# NEXT_PUBLIC_FIREBASE_* values, which take precedence over this file.
NEXT_PUBLIC_FIREBASE_API_KEY=build-validation-only
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=build-validation.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=build-validation
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=build-validation.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:buildvalidation
