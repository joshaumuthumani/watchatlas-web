# graphify: generated graph artifacts are machine-specific (mtime-keyed manifest,
# absolute interpreter path) and churn wholesale on rebuild. Keep the report only.
graphify-out/*
!graphify-out/GRAPH_REPORT.md

# Stage 10 review evidence is durable. Ignore only transient material, never results.
.ai-code-review/*
!.ai-code-review/results/
!.ai-code-review/results/.gitkeep
# Delivery state — worktrees and the like. Never committed.
.akb/
