# Server-only secrets (never expose these with NEXT_PUBLIC_)
TMDB_API_KEY=your_server_side_tmdb_api_key
CRON_SECRET=your_vercel_cron_secret
FIREBASE_ADMIN_SERVICE_ACCOUNT='{"project_id":"your-project-id","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}'

# Public Firebase web configuration (safe to expose, but restrict the app in Firebase)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Monitoring integrations (optional; configure only in deployment environment)
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
RESEND_API_KEY=re_your_resend_api_key
NOTIFICATION_EMAIL_TO=alerts@example.com
